APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./georush_seo.db

# Optional Cloudflare Radar URL Scanner
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional SERP provider for higher-volume competitor discovery
SERPER_API_KEY=

# Local Ollama AI — no API key required
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT=180
