APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./georush_seo.db

# Optional Cloudflare Radar URL Scanner
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional SERP provider for higher-volume competitor discovery
SERPER_API_KEY=

# Google Gemini AI Agent
# Keep this key on the GEORUSH API server only. Never put it in app.js or GitHub Pages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# GEORUSH 3-Agent Deep Research
# Uses the same Gemini API key for three specialized research roles.
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
